{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.(mjs|js)$": "./test/mjs-transformer.cjs"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(?:better-auth|thallesp|better-fetch|better-call|jose|noble|nanostores|rou3))"
  ],
  "collectCoverageFrom": [
    "src/**/*.(t|j)s",
    "!src/**/*.module.(t|j)s",
    "!src/main.(t|j)s",
    "!src/generate-openapi.(t|j)s",
    "!src/seed-*.(t|j)s"
  ],
  "coverageDirectory": "coverage"
}
