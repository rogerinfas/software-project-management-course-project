PORT=5000

DATABASE_URL="postgresql://postgres:postgres@localhost:4900/school_management?schema=public"

# Admin User
ADMIN_EMAIL=admin@santabeatriz.com
ADMIN_PASSWORD=Admin123!

# Teacher User
TEACHER_EMAIL=teacher@santabeatriz.com
TEACHER_PASSWORD=Teacher123!

# Staff User
STAFF_EMAIL=staff@santabeatriz.com
STAFF_PASSWORD=Staff123!

# Admission User
ADMISSION_EMAIL=admission@santabeatriz.com
ADMISSION_PASSWORD=Admission123!

# Treasury User
TREASURY_EMAIL=treasury@santabeatriz.com
TREASURY_PASSWORD=Treasury123!

# pgAdmin (solo si se habilita manualmente, no incluido en docker-compose actual)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Better Auth (generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
# Frontend admin (Next.js corre en puerto 2000: pnpm dev)
WEB_URL=http://localhost:2000
